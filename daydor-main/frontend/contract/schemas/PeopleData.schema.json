{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "headcount": {
      "type": "number"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PersonSummary"
      }
    }
  },
  "required": [
    "headcount",
    "people"
  ],
  "additionalProperties": false,
  "definitions": {
    "PersonSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/EmploymentStatus"
        },
        "joinDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null when the role reads people through the directory, which does not carry the joining date."
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "department",
        "status",
        "joinDate",
        "location"
      ],
      "additionalProperties": false
    },
    "EmploymentStatus": {
      "type": "string",
      "enum": [
        "active",
        "on-leave",
        "withdrawn"
      ]
    }
  }
}
