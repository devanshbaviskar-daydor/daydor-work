{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "brief": {
      "$ref": "#/definitions/BriefData"
    },
    "conversation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConversationTurn"
      }
    },
    "needsYou": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Decision"
      }
    },
    "runningNow": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Run"
      }
    },
    "doneToday": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Run"
      }
    },
    "doneTodayMoreCount": {
      "type": "number"
    }
  },
  "required": [
    "brief",
    "conversation",
    "needsYou",
    "runningNow",
    "doneToday"
  ],
  "additionalProperties": false,
  "definitions": {
    "BriefData": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "stats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BriefStat"
          }
        }
      },
      "required": [
        "greeting",
        "summary",
        "stats"
      ],
      "additionalProperties": false
    },
    "BriefStat": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "enum": [
            "warning",
            "brand"
          ]
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "ConversationTurn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "message"
            },
            "id": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "enum": [
                "user",
                "daydor"
              ]
            },
            "domain": {
              "type": "string"
            },
            "time": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "action": {
              "$ref": "#/definitions/TurnAction"
            }
          },
          "required": [
            "kind",
            "id",
            "from",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thinking"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "id",
            "label"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TurnAction": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open"
            },
            "path": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "$ref": "#/definitions/ProposedCommand"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "additionalProperties": false
        }
      ],
      "description": "What a reply from Daydor offers: open a screen, or confirm a command."
    },
    "ProposedCommand": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "POST",
            "PUT",
            "PATCH",
            "GET"
          ]
        },
        "path": {
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "confirm_required": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "method",
        "path",
        "summary",
        "risk",
        "kind",
        "confirm_required",
        "idempotency_key"
      ],
      "additionalProperties": false,
      "description": "A command Daydor proposes for the person to confirm: the real endpoint, in words (`summary`), with the idempotency key to send with it. Daydor never runs it."
    },
    "Decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "writeClass": {
          "$ref": "#/definitions/WriteLevel"
        },
        "summary": {
          "type": "string"
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecisionFigure"
          }
        },
        "why": {
          "type": "string"
        },
        "deadline": {
          "$ref": "#/definitions/DecisionDeadline"
        },
        "approveLabel": {
          "type": "string"
        },
        "reviewLabel": {
          "type": "string"
        },
        "escalation": {
          "type": "string"
        },
        "canDecide": {
          "type": "boolean",
          "description": "False when the signed-in role may not decide this (or raised it themselves); `cannotDecideReason` says why. Absent means the screen cannot tell."
        },
        "cannotDecideReason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "writeClass"
      ],
      "additionalProperties": false
    },
    "WriteLevel": {
      "type": "string",
      "enum": [
        "read",
        "guarded",
        "irreversible"
      ]
    },
    "DecisionFigure": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "DecisionDeadline": {
      "type": "object",
      "properties": {
        "daysLeft": {
          "type": "number"
        },
        "date": {
          "type": "string"
        }
      },
      "required": [
        "daysLeft"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "waiting",
            "done",
            "failed"
          ]
        },
        "domain": {
          "type": "string"
        },
        "meta": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "title",
        "state"
      ],
      "additionalProperties": false
    }
  }
}
